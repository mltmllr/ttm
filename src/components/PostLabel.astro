---
import type { Locale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';
import type { NewsPost } from '../lib/news';

interface Props {
  post: NewsPost;
  locale: Locale;
}

const { post, locale } = Astro.props;
const t = useTranslations(locale);
const isUrgent = post.entry.data.type === 'eil';
const text = isUrgent ? t('label.eil') : t('label.weekly', { week: post.week });
---

<span class:list={['au-badge', isUrgent ? 'au-badge-crimson' : 'au-badge-steel']}>
  {isUrgent && <span class="au-status-dot au-status-dot-danger post-label-dot" aria-hidden="true" />}
  {text}
</span>
