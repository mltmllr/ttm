---
import type { Locale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';
import type { NewsPost } from '../lib/news';
import PostCard from './PostCard.astro';

interface Props {
  posts: NewsPost[];
  locale: Locale;
  /** Text für den Leerzustand. */
  emptyTitle?: string;
  emptyBody?: string;
}

const { posts, locale, emptyTitle, emptyBody } = Astro.props;
const t = useTranslations(locale);
---

{
  posts.length > 0 ? (
    <div class="post-list">
      {posts.map((post) => <PostCard post={post} locale={locale} />)}
    </div>
  ) : (
    <div class="au-card au-card-trace-steel empty-state">
      <h3>{emptyTitle ?? t('home.empty.title')}</h3>
      <p>{emptyBody ?? t('list.empty')}</p>
    </div>
  )
}
