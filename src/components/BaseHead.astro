---
import { localeConfig, type Locale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';

interface Alternate {
  hreflang: string;
  href: string;
}

interface Props {
  documentTitle: string;
  description: string;
  canonical: string;
  locale: Locale;
  ogType: 'website' | 'article';
  alternates: Alternate[];
  rssHref: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
}

const {
  documentTitle,
  description,
  canonical,
  locale,
  ogType,
  alternates,
  rssHref,
  publishedTime,
  modifiedTime,
  noindex = false,
} = Astro.props;

const t = useTranslations(locale);
const ogLocale = localeConfig[locale].ogLocale;
const otherLocales = alternates.filter(
  (item) => item.hreflang !== 'x-default' && item.hreflang !== localeConfig[locale].hreflang,
);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{documentTitle}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}
<link rel="canonical" href={canonical} />
<link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
<link rel="alternate" type="application/rss+xml" title={t('site.title')} href={rssHref} />
{
  alternates.map((item) => (
    <link rel="alternate" hreflang={item.hreflang} href={item.href} />
  ))
}
<meta property="og:title" content={documentTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:site_name" content={t('site.title')} />
{
  otherLocales.map((item) => (
    <meta property="og:locale:alternate" content={item.hreflang.replace('-', '_')} />
  ))
}
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={documentTitle} />
<meta name="twitter:description" content={description} />
<meta name="theme-color" content="#f4f0e6" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#141311" media="(prefers-color-scheme: dark)" />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
<meta name="generator" content={Astro.generator} />
