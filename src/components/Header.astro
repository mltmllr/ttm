---
import { localeConfig, type Locale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';
import { categories } from '../lib/categories';
import { categoryPath, localePath, topicsPath } from '../lib/paths';

interface LanguageLink {
  lang: Locale;
  href: string;
  label: string;
  current: boolean;
}

interface Props {
  locale: Locale;
  pathname: string;
  languages?: LanguageLink[];
}

const { locale, pathname, languages = [] } = Astro.props;
const t = useTranslations(locale);
const home = localePath(locale);
const items = [
  ...categories.map((category) => ({
    href: categoryPath(locale, category.slug),
    label: category.label,
  })),
  { href: topicsPath(locale), label: t('nav.topics') },
];

function isCurrent(href: string): boolean {
  return pathname === href || pathname.startsWith(href);
}
---

<header class="site-nav">
  <a class="site-nav-logo" href={home}>
    <em>{t('site.short')}</em>
    <span class="site-nav-name">{t('site.title')}</span>
  </a>
  <button
    class="site-nav-toggle"
    type="button"
    aria-label={t('nav.toggle')}
    aria-expanded="false"
    aria-controls="site-nav-links"
    data-nav-toggle>&#9776;</button>
  <nav aria-label={t('nav.menu')} class="site-nav-menu">
    <ul class="site-nav-links" id="site-nav-links" data-nav-links>
      {
        items.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
      {
        languages.length > 1 &&
          languages.map((item) => (
            <li>
              {item.current ? (
                <span aria-current="true" lang={item.lang} class="site-nav-lang">
                  {item.label}
                </span>
              ) : (
                <a href={item.href} hreflang={localeConfig[item.lang].hreflang} lang={item.lang}>
                  {item.label}
                </a>
              )}
            </li>
          ))
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const links = document.querySelector<HTMLElement>('[data-nav-links]');
  toggle?.addEventListener('click', () => {
    const open = links?.classList.toggle('open') ?? false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
