---
interface Props {
  data: Record<string, unknown> | Record<string, unknown>[];
}

const blocks = Array.isArray(Astro.props.data) ? Astro.props.data : [Astro.props.data];
const serialized = blocks.map((block) => JSON.stringify(block).replaceAll('<', '\\u003c'));
---

{serialized.map((json) => <script type="application/ld+json" set:html={json} />)}
