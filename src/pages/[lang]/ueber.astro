---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localeFromParam, localeParams } from '../../i18n/locales';
import { assertLocaleFolder } from '../../lib/content';
import { aboutPath } from '../../lib/paths';

export function getStaticPaths() {
  return localeParams();
}

const locale = localeFromParam(Astro.params.lang);
const page = await getEntry('pages', `${locale}/ueber`);

if (!page) {
  throw new Error(
    `Seite "ueber" fehlt für "${locale}". Lege src/content/pages/${locale}/ueber.md an.`,
  );
}

assertLocaleFolder(page.id, page.data.lang);
if (page.data.lang !== locale) {
  throw new Error(`${page.id}: lang "${page.data.lang}" passt nicht zur Route "${locale}".`);
}

const { Content } = await render(page);
const pathname = aboutPath(locale);
---

<BaseLayout locale={locale} title={page.data.title} description={page.data.description} pathname={pathname}>
  <article class="measure">
    <h1>{page.data.title}</h1>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
