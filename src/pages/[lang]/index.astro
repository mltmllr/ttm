---
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localeFromParam, localeParams } from '../../i18n/locales';
import { useTranslations } from '../../i18n/ui';
import { categories } from '../../lib/categories';
import { newsForLocale } from '../../lib/news';
import { categoryPath, localePath, rssPath } from '../../lib/paths';

export function getStaticPaths() {
  return localeParams();
}

const locale = localeFromParam(Astro.params.lang);
const t = useTranslations(locale);
const posts = (await newsForLocale(locale)).slice(0, 12);
const pathname = localePath(locale);
const empty = posts.length === 0;
---

<BaseLayout locale={locale} description={t('site.description')} pathname={pathname}>
  <section class="hero">
    <div class="hero-grid"></div>
    <div class="hero-orb"></div>
    <div class="hero-inner">
      <span class="au-badge au-badge-crimson">GA4 · GTM · Stape · SEO/GEO · KI</span>
      <h1>The <span class="accent">Technical</span> Marketer</h1>
      <p class="hero-sub">{t('home.lead')}</p>
      <div class="hero-actions">
        <a class="au-btn au-btn-primary" href={rssPath(locale)}>RSS abonnieren</a>
      </div>
    </div>
  </section>

  <div class="sect-divider"></div>
  <section class="sect" aria-labelledby="latest-title">
    <div class="sect-inner">
      <div class="sect-head">
        <div class="sect-label au-text-crimson">{t('home.latest')}</div>
        <h2 class="sect-title" id="latest-title">{t('home.title')}</h2>
      </div>
      <PostList
        posts={posts}
        locale={locale}
        emptyTitle={t('home.empty.title')}
        emptyBody={t('home.empty.body')}
      />
    </div>
  </section>

  <div class="sect-divider"></div>
  <section class="sect" aria-labelledby="categories-title">
    <div class="sect-inner">
      <div class="sect-head">
        <div class="sect-label au-text-copper">{t('home.categories')}</div>
        <h2 class="sect-title" id="categories-title" style="font-size: var(--au-text-3xl);">{t('home.categories')}</h2>
      </div>
      <ul class="grid-3" style="list-style:none;padding:0;margin:0;">
        {
          categories.map((category) => (
            <li style="margin:0;">
              <a class="au-card au-card-trace-crimson category-card" href={categoryPath(locale, category.slug)}>
                <h3>{category.label}</h3>
                <p>{category.description}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
