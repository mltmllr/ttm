---
import ArticleCard from '../../../components/ArticleCard.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { localeFromParam } from '../../../i18n/locales';
import { topicDescriptionKey, topicLabelKey, useTranslations } from '../../../i18n/ui';
import { articlesForTopic, getArticles } from '../../../lib/articles';
import { topicPath, topicsPath } from '../../../lib/paths';
import { topicFromParam, topicParams } from '../../../lib/topics';

export function getStaticPaths() {
  return topicParams();
}

const locale = localeFromParam(Astro.params.lang);
const topic = topicFromParam(Astro.params.topic);
const t = useTranslations(locale);
const pathname = topicPath(locale, topic);
const articles = articlesForTopic(await getArticles(), locale, topic);
const title = t(topicLabelKey(topic));
const description = t(topicDescriptionKey(topic));
---

<BaseLayout locale={locale} title={title} description={description} pathname={pathname}>
  <header>
    <p class="kicker">
      <a href={topicsPath(locale)}>{t('topics.title')}</a>
    </p>
    <h1>{title}</h1>
    <p class="lede">{description}</p>
  </header>
  {
    articles.length === 0 ? (
      <p>{t('topics.empty')}</p>
    ) : (
      <ol class="entry-list">
        {articles.map((article) => (
          <li>
            <ArticleCard article={article} locale={locale} />
          </li>
        ))}
      </ol>
    )
  }
</BaseLayout>
