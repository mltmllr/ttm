---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { localeFromParam, localeParams } from '../../../i18n/locales';
import { topicDescriptionKey, topicLabelKey, useTranslations } from '../../../i18n/ui';
import { articlesForTopic, getArticles } from '../../../lib/articles';
import { topicPath, topicsPath } from '../../../lib/paths';
import { formatCount } from '../../../lib/seo';
import { topics } from '../../../lib/topics';

export function getStaticPaths() {
  return localeParams();
}

const locale = localeFromParam(Astro.params.lang);
const t = useTranslations(locale);
const pathname = topicsPath(locale);
const articles = await getArticles();
---

<BaseLayout locale={locale} title={t('topics.title')} description={t('topics.lead')} pathname={pathname}>
  <header>
    <h1>{t('topics.title')}</h1>
    <p class="lede">{t('topics.lead')}</p>
  </header>
  <ul class="topic-index">
    {
      topics.map((topic) => {
        const count = articlesForTopic(articles, locale, topic).length;
        const countLabel = formatCount(
          count === 1 ? t('topics.count.one') : t('topics.count.other'),
          count,
        );
        return (
          <li>
            <h2>
              <a href={topicPath(locale, topic)}>{t(topicLabelKey(topic))}</a>
            </h2>
            <p>{t(topicDescriptionKey(topic))}</p>
            <p class="meta">{countLabel}</p>
          </li>
        );
      })
    }
  </ul>
</BaseLayout>
